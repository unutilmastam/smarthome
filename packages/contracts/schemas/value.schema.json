{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarthome.local/contracts/value.schema.json",
  "title": "Value with trust metadata (ARCHITECTURE 4.2)",
  "description": "Every attribute value is reported together with its source and quality. No data -> quality unknown and value null. Never invent values.",
  "type": "object",
  "required": ["value", "source", "quality", "ts"],
  "additionalProperties": false,
  "properties": {
    "value": {},
    "unit": { "type": "string", "minLength": 1 },
    "source": { "enum": ["reported", "assumed", "computed"] },
    "quality": { "enum": ["good", "stale", "unknown", "not_supported"] },
    "ts": {
      "description": "UTC timestamp of the measurement. null when nothing was ever received.",
      "oneOf": [
        { "type": "string", "format": "date-time", "pattern": "Z$" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "quality": { "enum": ["unknown", "not_supported"] } } },
      "then": { "properties": { "value": { "type": "null" } } }
    },
    {
      "if": { "properties": { "quality": { "enum": ["good", "stale"] } } },
      "then": {
        "properties": {
          "value": { "not": { "type": "null" } },
          "ts": { "type": "string" }
        }
      }
    }
  ]
}
