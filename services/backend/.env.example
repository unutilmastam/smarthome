# Copy to .env and fill in. Never commit .env.
# ENV: development | test | production
ENV=development

# PostgreSQL in production, e.g. postgresql+psycopg://user:password@localhost:5432/smarthome
# SQLite is refused when ENV=production.
DATABASE_URL=sqlite:///./dev.db

# >= 32 random characters each. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Development defaults are refused when ENV=production.
JWT_SECRET=
SIGNING_MASTER_KEY=

# Optional: path to packages/contracts (defaults to the repo copy or ./contracts next to the app)
# CONTRACTS_DIR=

# Optional tuning
# HUB_ONLINE_WINDOW_S=90
# STALE_FACTOR=3

# Real-time (ADR 0008): none | emqx_serverless. Polling always stays as fallback.
REALTIME_PROVIDER=none
# EMQX Cloud Serverless -> Overview -> API: base URL, App ID, App Secret
# EMQX_API_BASE=https://xxxx.ala.eu-central-1.emqxsl.com:8443/api
# EMQX_APP_ID=
# EMQX_APP_SECRET=
# REALTIME_WSS_URL=wss://xxxx.ala.eu-central-1.emqxsl.com:8084/mqtt

# Notifications (ADR 0014). deploy.sh fills these ON THE SERVER; never commit real values.
# PUBLIC_BASE_URL=https://home.example.uz
# TELEGRAM_BOT_TOKEN=            # from @BotFather (GitHub Secret TELEGRAM_BOT_TOKEN)
# TELEGRAM_WEBHOOK_SECRET=       # >= 32 random chars: python -c "import secrets; print(secrets.token_hex(32))"
# TELEGRAM_BOT_USERNAME=         # optional, asked from Telegram when missing
# VAPID_PRIVATE_KEY=             # python -c "from app.services.webpush import generate_private_key as g; print(g())"
# VAPID_SUBJECT=mailto:owner@example.com
