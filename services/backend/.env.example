# Copy to .env and fill in. Never commit .env.
# ENV: development | test | production
ENV=development

# PostgreSQL in production, e.g. postgresql+psycopg://user:password@localhost:5432/smarthome
# SQLite is refused when ENV=production.
DATABASE_URL=sqlite:///./dev.db

# >= 32 random characters each. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Development defaults are refused when ENV=production.
JWT_SECRET=
SIGNING_MASTER_KEY=

# Optional: path to packages/contracts (defaults to the repo copy or ./contracts next to the app)
# CONTRACTS_DIR=

# Optional tuning
# HUB_ONLINE_WINDOW_S=90
# STALE_FACTOR=3
