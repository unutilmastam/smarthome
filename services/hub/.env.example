# Home Hub gateway. Copy to .env (never commit .env).
# Values for HUB_TOKEN and SIGNING_KEY_HEX are shown ONCE when the hub is created
# in the app (POST /api/v1/homes/{id}/hubs).
BACKEND_URL=https://home.example.uz
HUB_TOKEN=
SIGNING_KEY_HEX=

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=gateway
MQTT_PASSWORD=

# SQLite: executed command ids, offline buffer, state cache
DB_PATH=/data/hub.sqlite3

# Optional tuning
# POLL_INTERVAL_S=1.5
# HEARTBEAT_INTERVAL_S=30
# CLOCK_SKEW_S=5

# Simulator only (docker compose profile "sim")
SIM_DEVICE_PASSWORD=

# Managed cloud broker (ADR 0008, optional). Empty = HTTPS polling only.
# CLOUD_MQTT_HOST=xxxx.ala.eu-central-1.emqxsl.com
# CLOUD_MQTT_PORT=8883
# CLOUD_MQTT_USERNAME=hub-<home_id>
# CLOUD_MQTT_PASSWORD=

# ESPHome dashboard login (LAN/Tailscale only)
ESPHOME_USERNAME=admin
ESPHOME_PASSWORD=

# Cameras (docker compose --profile cameras). Leave FRIGATE_URL empty without cameras.
# FRIGATE_URL=http://frigate:5000
# TAILNET_HOST=hub.tailXXXX.ts.net
LAN_HOST=hub.local
FRIGATE_RTSP_USER=
FRIGATE_RTSP_PASSWORD=
